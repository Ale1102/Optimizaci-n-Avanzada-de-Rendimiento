# Nombre de la aplicación (opcional)
NEXT_PUBLIC_APP_NAME=E-Commerce Store

# URL base de la API (sin trailing slash)
#
# Opción A — API Laravel real:
#   API_BASE_URL=http://localhost:8000/api
#
# Opción B — Servidor mock interno (modo demo, sin backend):
#   API_BASE_URL=http://localhost:3000/api/mock
API_BASE_URL=http://localhost:8000/api
